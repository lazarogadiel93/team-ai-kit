#!/usr/bin/env bash
# Team AI Kit CLI -- gentle-ai for teams (macOS/Linux)
#
# Usage:
#   team-ai-kit <command> [options]
#
# Commands:
#   setup          First-time configuration (IDE, role, team repo)
#   init           Initialize team-ai-kit in the current project
#   init-knowledge Scaffold a Team Knowledge Repo in the current directory
#   sync           Manually sync engram memories (export + import)
#   update   Pull latest team content + merge without overwriting
#   status   Show current config and installed skills
#   doctor   Verify prerequisites and installation health
#   help     Show this help message
#
# Setup options:
#   --ide <vscode|intellij|opencode|cursor>
#   --role <frontend|backend-node|backend-java|backend-dotnet|devops|python|mobile|data>
#   --provider <openai|azure-openai|anthropic|github-copilot>
#   --team-repo <url>         Team content repo URL
#   --target-dir <path>       Custom output directory
#   --skip-prerequisites      Skip brew/gentle-ai checks
#   --skip-gentle-ai          Skip gentle-ai install step
#
# Init options:
#   --role <role>             Override global role for this project
#   --team-repo <url>         Per-project team knowledge repo URL
#   --force                   Re-initialize without asking
#
# Examples:
#   team-ai-kit setup
#   team-ai-kit setup --ide vscode --role frontend
#   team-ai-kit setup --ide vscode --role frontend --team-repo https://github.com/team/knowledge
#   team-ai-kit init
#   team-ai-kit init --role backend-node
#   team-ai-kit init --team-repo https://github.com/team/knowledge
#   team-ai-kit init --role frontend --force
#   team-ai-kit update
#   team-ai-kit status

set -euo pipefail

# -- Version -------------------------------------------------------------------
KIT_VERSION='2.6.3'

# -- Resolve paths -------------------------------------------------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_ROOT="$(dirname "$SCRIPT_DIR")"

# shellcheck source=../lib/functions.sh
source "$KIT_ROOT/lib/functions.sh"

# -- ANSI colors ---------------------------------------------------------------
if [[ -t 1 ]]; then
    C_RESET='\033[0m'
    C_CYAN='\033[0;36m'
    C_GREEN='\033[0;32m'
    C_YELLOW='\033[0;33m'
    C_RED='\033[0;31m'
    C_MAGENTA='\033[0;35m'
    C_WHITE='\033[1;37m'
    C_DIM='\033[0;90m'
else
    C_RESET='' C_CYAN='' C_GREEN='' C_YELLOW='' C_RED='' C_MAGENTA='' C_WHITE='' C_DIM=''
fi

# -- Output helpers ------------------------------------------------------------
step()  { echo -e "  ${C_CYAN}> $1${C_RESET}"; }
ok()    { echo -e "  ${C_GREEN}+ $1${C_RESET}"; }
warn()  { echo -e "  ${C_YELLOW}! $1${C_RESET}"; }
err()   { echo -e "  ${C_RED}x $1${C_RESET}"; }

# -- Banner --------------------------------------------------------------------
show_banner() {
    echo ""
    echo -e "  ${C_MAGENTA}+======================================+${C_RESET}"
    echo -e "  ${C_MAGENTA}|        Team AI Kit -- CLI            |${C_RESET}"
    echo -e "  ${C_MAGENTA}|  gentle-ai for teams                 |${C_RESET}"
    echo -e "  ${C_MAGENTA}+======================================+${C_RESET}"
    echo ""
}

# -- Dry-run helper ------------------------------------------------------------
dry() { echo -e "  ${C_CYAN}[DRY-RUN]${C_RESET} $1"; }

# -- Help ----------------------------------------------------------------------
show_help() {
    show_banner
    echo -e "  ${C_WHITE}Usage: team-ai-kit <command> [options]${C_RESET}"
    echo ""
    echo -e "  ${C_YELLOW}Commands:${C_RESET}"
    echo "    setup           First-time configuration (IDE, role, team repo)"
    echo "    init            Initialize team-ai-kit in the current project"
    echo "    init-knowledge  Scaffold a Team Knowledge Repo in the current directory"
    echo "    sync            Manually sync engram memories (export + import)"
    echo "    update   Pull latest team content + merge without overwriting"
    echo "    status   Show current config and installed skills"
    echo "    doctor   Verify prerequisites and installation health"
    echo "    uninstall       Remove team-ai-kit from the current project"
    echo "    help     Show this help message"
    echo ""
    echo -e "  ${C_YELLOW}Setup options:${C_RESET}"
    echo "    --ide <vscode|intellij|opencode|cursor>"
    echo "    --role <frontend|backend-node|backend-java|backend-dotnet|devops|python|mobile|data>"
    echo "    --provider <openai|azure-openai|anthropic|github-copilot>"
    echo "    --team-repo <url>          Team content repo URL"
    echo "    --target-dir <path>        Custom output directory"
    echo "    --skip-prerequisites       Skip brew/gentle-ai checks"
    echo "    --skip-gentle-ai           Skip gentle-ai install step"
    echo ""
    echo -e "  ${C_YELLOW}Init options:${C_RESET}"
    echo "    --role <role>              Override global role for this project"
    echo "    --force                    Re-initialize without asking"
    echo "    --dry-run                  Preview changes without writing to disk"
    echo ""
    echo -e "  ${C_YELLOW}Examples:${C_RESET}"
    echo "    team-ai-kit setup"
    echo "    team-ai-kit setup --ide vscode --role frontend"
    echo "    team-ai-kit setup --ide vscode --role frontend --team-repo https://github.com/team/knowledge"
    echo "    team-ai-kit init"
    echo "    team-ai-kit init --role backend-node"
    echo "    team-ai-kit init --role frontend --force"
    echo "    team-ai-kit uninstall"
    echo "    team-ai-kit uninstall --force"
    echo "    team-ai-kit update"
    echo "    team-ai-kit status"
    echo ""
}

# -- Setup ---------------------------------------------------------------------
cmd_setup() {
    show_banner
    echo -e "  ${C_DIM}3 questions. 2 minutes. Full power.${C_RESET}"
    echo ""

    # -- Step 1: Prerequisites -------------------------------------------------
    if [[ "$SKIP_PREREQUISITES" == "false" ]]; then
        echo -e "  ${C_WHITE}[1/5] Checking prerequisites...${C_RESET}"

        if ! test_jq_installed; then
            err "jq is required but not found"
            step "Install: brew install jq (macOS) or apt install jq (Debian/Ubuntu)"
            exit 1
        fi
        ok "jq available"

        if ! test_curl_installed; then
            err "curl is required but not found"
            exit 1
        fi

        # -- gentle-ai --
        if test_gentle_ai_installed; then
            ok "gentle-ai available"
        elif test_brew_installed; then
            step "Installing gentle-ai via Homebrew..."
            if brew tap Gentleman-Programming/tap 2>/dev/null && brew install gentle-ai 2>/dev/null; then
                ok "gentle-ai installed via Homebrew"
            else
                warn "Homebrew install failed -- trying direct download..."
                if dl_result=$(install_github_release_binary "Gentleman-Programming" "gentle-ai" "gentle-ai"); then
                    add_to_path_if_needed "$(get_direct_download_bin_dir)" >/dev/null
                    local dl_version
                    dl_version=$(echo "$dl_result" | jq -r '.version')
                    ok "gentle-ai $dl_version installed via direct download"
                else
                    err "Failed to install gentle-ai"
                    err "Download manually from: https://github.com/Gentleman-Programming/gentle-ai/releases"
                    exit 1
                fi
            fi
        else
            step "Homebrew not available -- downloading gentle-ai directly..."
            if dl_result=$(install_github_release_binary "Gentleman-Programming" "gentle-ai" "gentle-ai"); then
                add_to_path_if_needed "$(get_direct_download_bin_dir)" >/dev/null
                local dl_version
                dl_version=$(echo "$dl_result" | jq -r '.version')
                ok "gentle-ai $dl_version installed via direct download"
            else
                err "Failed to install gentle-ai"
                err "Download manually from: https://github.com/Gentleman-Programming/gentle-ai/releases"
                exit 1
            fi
        fi

        # -- engram --
        if test_engram_installed; then
            ok "engram available"
        else
            step "Installing engram..."
            if test_brew_installed; then
                if brew install engram 2>/dev/null; then
                    ok "engram installed via Homebrew"
                else
                    if dl_result=$(install_github_release_binary "Gentleman-Programming" "engram" "engram"); then
                        add_to_path_if_needed "$(get_direct_download_bin_dir)" >/dev/null
                        local dl_version
                        dl_version=$(echo "$dl_result" | jq -r '.version')
                        ok "engram $dl_version installed via direct download"
                    else
                        warn "Failed to install engram -- gentle-ai install will set it up"
                    fi
                fi
            else
                if dl_result=$(install_github_release_binary "Gentleman-Programming" "engram" "engram"); then
                    add_to_path_if_needed "$(get_direct_download_bin_dir)" >/dev/null
                    local dl_version
                    dl_version=$(echo "$dl_result" | jq -r '.version')
                    ok "engram $dl_version installed via direct download"
                else
                    warn "Failed to install engram -- gentle-ai install will set it up"
                fi
            fi
        fi
    else
        echo -e "  ${C_DIM}[1/5] Skipping prerequisites (--skip-prerequisites)${C_RESET}"
    fi

    # -- Step 2: IDE Selection -------------------------------------------------
    echo ""
    echo -e "  ${C_WHITE}[2/5] IDE Selection${C_RESET}"

    if [[ -z "$OPT_IDE" ]]; then
        echo "    1) VS Code + Copilot"
        echo "    2) IntelliJ + Copilot"
        echo "    3) OpenCode (CLI)"
        echo "    4) Cursor"
        echo ""
        while true; do
            read -rp "  Your IDE (1-4): " ide_choice
            case "$ide_choice" in
                1) OPT_IDE="vscode"; break ;;
                2) OPT_IDE="intellij"; break ;;
                3) OPT_IDE="opencode"; break ;;
                4) OPT_IDE="cursor"; break ;;
                *) echo "  Invalid choice. Enter 1, 2, 3, or 4." ;;
            esac
        done
    fi
    ok "IDE: $OPT_IDE"

    # -- Step 3: Role + Provider -----------------------------------------------
    echo ""
    echo -e "  ${C_WHITE}[3/5] Role Selection${C_RESET}"

    if [[ -z "$OPT_ROLE" ]]; then
        echo "    1) Frontend (React / Next.js / Angular / Vue)"
        echo "    2) Backend - Node.js (Express / Fastify)"
        echo "    3) Backend - Java (Spring Boot / JPA)"
        echo "    4) Backend - .NET (ASP.NET Core / EF Core)"
        echo "    5) DevOps (CI/CD / Docker / Infra)"
        echo "    6) Python (FastAPI / Django)"
        echo "    7) Mobile (React Native / Expo)"
        echo "    8) Data (pandas / scikit-learn / ML)"
        echo ""
        while true; do
            read -rp "  Your role (1-8): " role_choice
            case "$role_choice" in
                1) OPT_ROLE="frontend"; break ;;
                2) OPT_ROLE="backend-node"; break ;;
                3) OPT_ROLE="backend-java"; break ;;
                4) OPT_ROLE="backend-dotnet"; break ;;
                5) OPT_ROLE="devops"; break ;;
                6) OPT_ROLE="python"; break ;;
                7) OPT_ROLE="mobile"; break ;;
                8) OPT_ROLE="data"; break ;;
                *) echo "  Invalid choice. Enter 1-8." ;;
            esac
        done
    fi
    ok "Role: $OPT_ROLE"

    # Provider: auto-detect for Copilot IDEs, ask only for OpenCode
    if [[ -z "$OPT_PROVIDER" ]]; then
        if [[ "$OPT_IDE" == "vscode" || "$OPT_IDE" == "intellij" || "$OPT_IDE" == "cursor" ]]; then
            OPT_PROVIDER="github-copilot"
            ok "Provider: $OPT_PROVIDER (auto-detected from IDE)"
        else
            echo ""
            echo -e "    ${C_WHITE}AI Provider (OpenCode requires direct API access):${C_RESET}"
            echo "    1) OpenAI"
            echo "    2) Azure OpenAI"
            echo "    3) Anthropic"
            echo ""
            while true; do
                read -rp "  Your provider (1-3): " provider_choice
                case "$provider_choice" in
                    1) OPT_PROVIDER="openai"; break ;;
                    2) OPT_PROVIDER="azure-openai"; break ;;
                    3) OPT_PROVIDER="anthropic"; break ;;
                    *) echo "  Invalid choice. Enter 1-3." ;;
                esac
            done
            ok "Provider: $OPT_PROVIDER"
        fi
    else
        ok "Provider: $OPT_PROVIDER"
    fi

    # -- Step 4: Base Configuration (gentle-ai) --------------------------------
    echo ""
    echo -e "  ${C_WHITE}[4/5] Base configuration...${C_RESET}"

    local agent_id=""
    agent_id=$(get_gentle_ai_agent_id "$OPT_IDE" 2>/dev/null) || true

    if [[ -n "$agent_id" && "$SKIP_GENTLE_AI" == "false" ]]; then
        local gentle_bin=""
        gentle_bin=$(get_gentle_ai_binary_path 2>/dev/null) || true
        step "Running: gentle-ai install --agent $agent_id --preset ecosystem-only"
        step "This installs: engram, SDD, skills, context7, persona"
        echo ""

        if [[ -n "$gentle_bin" ]] && "$gentle_bin" install --agent "$agent_id" --preset ecosystem-only --persona gentleman 2>/dev/null; then
            ok "gentle-ai configured for $agent_id"
        else
            warn "gentle-ai install failed or exited with error"
            warn "Run gentle-ai manually after setup completes"
        fi
    elif [[ "$SKIP_GENTLE_AI" == "true" ]]; then
        step "Skipping gentle-ai install (--skip-gentle-ai)"
    else
        # IntelliJ/Cursor: no gentle-ai adapter
        local ide_name
        if [[ "$OPT_IDE" == "cursor" ]]; then ide_name="Cursor"; else ide_name="IntelliJ + Copilot"; fi
        step "$ide_name: no gentle-ai adapter available"
        step "Setting up MCP config from template..."

        local template_dir=""
        template_dir=$(get_template_directory "$KIT_ROOT" "$OPT_IDE" 2>/dev/null) || true

        if [[ -n "$template_dir" ]]; then
            local engram_bin=""
            engram_bin=$(get_engram_binary_path 2>/dev/null) || engram_bin="(not-found -- install engram)"

            if [[ -n "$OPT_TARGET_DIR" ]]; then
                local tpl_target="$OPT_TARGET_DIR/ide-config"
                install_templates "$template_dir" "$tpl_target" "ENGRAM_BINARY_PATH=$engram_bin"
                ok "$ide_name config files generated"
            else
                local mcp_json
                if [[ "$OPT_IDE" == "cursor" ]]; then
                    mcp_json=$(new_cursor_mcp_config "$engram_bin")
                else
                    mcp_json=$(new_vscode_mcp_config "$engram_bin")
                fi
                ok "MCP config generated for $ide_name"
                step "Add this to your $ide_name MCP settings:"
                echo ""
                echo -e "  ${C_DIM}$mcp_json${C_RESET}"
                echo ""
            fi
        fi
    fi

    # -- Step 5: Team Layer ----------------------------------------------------
    echo ""
    echo -e "  ${C_WHITE}[5/5] Installing team layer...${C_RESET}"

    # 5a. Clone team repo if configured
    local has_team_repo="false"
    if [[ -n "$OPT_TEAM_REPO" ]]; then
        step "Cloning team repo: $OPT_TEAM_REPO"
        if invoke_team_repo_clone "$OPT_TEAM_REPO"; then
            ok "Team repo cloned"
            has_team_repo="true"
        else
            warn "Failed to clone team repo -- continuing with defaults only"
        fi
    fi

    # 5b. Install kit base skills to global (team-repo skills go to project via init)
    local target_skills_dir
    if [[ -n "$OPT_TARGET_DIR" ]]; then
        target_skills_dir="$OPT_TARGET_DIR"
    else
        target_skills_dir=$(get_ide_skills_directory "$OPT_IDE")
    fi

    step "Global skills target: $target_skills_dir"

    local merge_json
    merge_json=$(install_skills_with_merge "$KIT_ROOT" "$OPT_ROLE" "$target_skills_dir" "false" "")
    local total_installed total_updated total_skipped
    total_installed=$(echo "$merge_json" | jq -r '.installed')
    total_updated=$(echo "$merge_json" | jq -r '.updated')
    total_skipped=$(echo "$merge_json" | jq -r '.skipped')
    ok "$total_installed installed, $total_updated updated, $total_skipped unchanged"
    step "Run 'team-ai-kit init' in each project to apply instructions"

    # -- Save config -----------------------------------------------------------
    local now
    now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
    local config_json
    config_json=$(jq -n \
        --arg ide "$OPT_IDE" \
        --arg role "$OPT_ROLE" \
        --arg provider "$OPT_PROVIDER" \
        --arg team_repo "$OPT_TEAM_REPO" \
        --arg installed_at "$now" \
        --arg last_update "$now" \
        --arg version "$KIT_VERSION" \
        '{ide:$ide, role:$role, provider:$provider, teamRepo:$team_repo, installedAt:$installed_at, lastUpdate:$last_update, version:$version}')
    local config_path
    config_path=$(save_config "$config_json")
    ok "Config saved: $config_path"

    # -- Summary ---------------------------------------------------------------
    echo ""
    local skills_total=$((total_installed + total_updated))
    local gentle_status
    if [[ -n "$agent_id" && "$SKIP_GENTLE_AI" == "false" ]]; then
        gentle_status="configured"
    else
        gentle_status="manual setup"
    fi
    echo -e "${C_GREEN}$(new_setup_summary "$OPT_IDE" "$OPT_ROLE" "$OPT_PROVIDER" "$skills_total" "$gentle_status")${C_RESET}"

    echo ""
    echo -e "  ${C_YELLOW}Next steps:${C_RESET}"
    if [[ -n "$agent_id" && "$SKIP_GENTLE_AI" == "false" ]]; then
        echo -e "    ${C_WHITE}1. Go to your project and run: team-ai-kit init${C_RESET}"
        echo -e "    ${C_DIM}   (configures instructions, team skills, engram sync, and git hooks)${C_RESET}"
        echo -e "    ${C_WHITE}2. Open your IDE and start working!${C_RESET}"
    elif ! test_gentle_ai_supports_ide "$OPT_IDE"; then
        echo -e "    ${C_WHITE}1. Add the MCP config shown above to your IDE settings${C_RESET}"
        echo -e "    ${C_WHITE}2. Go to your project and run: team-ai-kit init${C_RESET}"
        echo -e "    ${C_DIM}   (configures instructions, team skills, engram sync, and git hooks)${C_RESET}"
        local open_ide_name
        if [[ "$OPT_IDE" == "cursor" ]]; then open_ide_name="Cursor"; else open_ide_name="IntelliJ"; fi
        echo -e "    ${C_WHITE}3. Open $open_ide_name and start working!${C_RESET}"
    else
        echo -e "    ${C_WHITE}1. Run gentle-ai to complete agent configuration${C_RESET}"
        echo -e "    ${C_WHITE}2. Go to your project and run: team-ai-kit init${C_RESET}"
        echo -e "    ${C_DIM}   (configures instructions, team skills, engram sync, and git hooks)${C_RESET}"
        echo -e "    ${C_WHITE}3. Open your IDE and start working!${C_RESET}"
    fi
    echo ""
}

# -- Init (project-level) -----------------------------------------------------
cmd_init() {
    show_banner
    _require_jq || exit 1
    local project_root
    project_root=$(pwd)

    # -- Step 1: Check global config -------------------------------------------
    echo -e "  ${C_WHITE}[1/4] Checking global configuration...${C_RESET}"
    local global_ide global_role
    global_ide=$(get_config_value "ide")
    global_role=$(get_config_value "role")

    if [[ -z "$global_ide" ]]; then
        err "No global configuration found."
        err 'Run "team-ai-kit setup" first to configure your IDE and role.'
        exit 1
    fi
    ok "Global config: IDE=$global_ide, Role=$global_role"

    # -- Step 2: Check if already initialized ----------------------------------
    echo ""
    echo -e "  ${C_WHITE}[2/4] Checking project state...${C_RESET}"

    if test_project_initialized "$project_root"; then
        local existing_role existing_ide existing_at
        existing_role=$(get_project_config_value "$project_root" "role")
        existing_ide=$(get_project_config_value "$project_root" "ide")
        existing_at=$(get_project_config_value "$project_root" "initializedAt")

        if [[ "$OPT_FORCE" == "true" ]]; then
            warn "Already initialized (Role=$existing_role). Re-initializing (--force)."
        elif [[ -z "$OPT_ROLE" && -z "$OPT_TEAM_REPO" ]]; then
            # Interactive mode: show config and ask
            warn "This project is already initialized:"
            echo -e "    ${C_DIM}Role:        $existing_role${C_RESET}"
            echo -e "    ${C_DIM}IDE:         $existing_ide${C_RESET}"
            echo -e "    ${C_DIM}Initialized: $existing_at${C_RESET}"
            echo ""
            read -rp "  Want to re-initialize? (y/n): " answer
            if [[ "$answer" != "y" && "$answer" != "Y" && "$answer" != "yes" ]]; then
                step 'Cancelled. Run "team-ai-kit update" to pull latest changes instead.'
                return
            fi
        else
            # Non-interactive: fail with clear message
            err "Project already initialized. Use --force to re-initialize."
            echo -e "    ${C_DIM}Current role: $existing_role${C_RESET}"
            exit 1
        fi
    else
        ok "New project -- initializing"
    fi

    # -- Resolve effective role ------------------------------------------------
    local effective_role effective_ide
    effective_role="${OPT_ROLE:-$global_role}"
    effective_ide="$global_ide"
    ok "Role for this project: $effective_role"

    # -- Step 3: Generate project files ----------------------------------------
    echo ""
    echo -e "  ${C_WHITE}[3/4] Generating project files...${C_RESET}"

    # 3a. Instructions file
    local instructions_path
    instructions_path=$(get_ide_instructions_path "$effective_ide" "$project_root")
    local instructions_dir
    instructions_dir=$(dirname "$instructions_path")
    [[ -d "$instructions_dir" ]] || mkdir -p "$instructions_dir"

    local pack_rules_content="" pack_rules_path=""
    pack_rules_path=$(get_pack_rules_path "$KIT_ROOT" "$effective_role" 2>/dev/null) || true
    if [[ -n "$pack_rules_path" ]]; then
        pack_rules_content=$(cat "$pack_rules_path")
    fi

    # Resolve team repo URL: CLI param > project config > global config
    local effective_team_repo=""
    if [[ -n "$OPT_TEAM_REPO" ]]; then
        effective_team_repo="$OPT_TEAM_REPO"
    elif test_project_initialized "$project_root"; then
        effective_team_repo=$(get_project_config_value "$project_root" "teamRepo" 2>/dev/null) || true
    fi
    if [[ -z "$effective_team_repo" ]]; then
        effective_team_repo=$(get_config_value "teamRepo" 2>/dev/null) || true
    fi

    # Clone/pull team repo if configured
    local team_rules_content=""
    if [[ -n "$effective_team_repo" ]]; then
        step "Team repo: $effective_team_repo"
        if test_team_repo_cloned "$effective_team_repo"; then
            if invoke_team_repo_pull "$effective_team_repo"; then
                ok "Team repo updated"
            else
                warn "Failed to pull -- using cached version"
            fi
        else
            if invoke_team_repo_clone "$effective_team_repo"; then
                ok "Team repo cloned"
            else
                warn "Failed to clone team repo"
            fi
        fi
        team_rules_content=$(get_team_repo_rules_content "$effective_team_repo")
        if [[ -n "$team_rules_content" ]]; then
            ok "Team rules loaded from knowledge repo"
        fi
    fi

    local skip_engram_protocol="false"
    if test_gentle_ai_supports_ide "$effective_ide"; then
        skip_engram_protocol="true"
    fi

    local rel_instructions_path="${instructions_path#$project_root/}"

    if [[ "$OPT_DRY_RUN" == "true" ]]; then
        dry "Would create: $rel_instructions_path"
    else
        local instructions
        instructions=$(new_copilot_instructions "$effective_role" "$pack_rules_content" "$team_rules_content" "$skip_engram_protocol")
        printf '%s\n' "$instructions" > "$instructions_path"
        ok "Created: $rel_instructions_path"
    fi

    # 3b. Install team-repo skills to project-level directory
    if [[ -n "$effective_team_repo" ]] && test_team_repo_cloned "$effective_team_repo"; then
        local project_skills_dir
        project_skills_dir=$(get_ide_project_skills_directory "$effective_ide" "$project_root")
        local rel_skills_dir="${project_skills_dir#$project_root/}"

        if [[ "$OPT_DRY_RUN" == "true" ]]; then
            dry "Would install team skills to: $rel_skills_dir"
        else
            step "Installing team skills to project: $rel_skills_dir"

            local ps_json ps_installed ps_updated
            ps_json=$(install_project_skills "$effective_role" "$effective_team_repo" "$project_skills_dir")
            ps_installed=$(echo "$ps_json" | jq -r '.installed')
            ps_updated=$(echo "$ps_json" | jq -r '.updated')
            local ps_total=$((ps_installed + ps_updated))
            if [[ "$ps_total" -gt 0 ]]; then
                ok "$ps_installed installed, $ps_updated updated team skills"
            else
                step "No team skills to install (repo has no skills for this role)"
            fi
        fi
    fi

    # -- Step 4: Setup engram sync + git hooks --------------------------------
    echo ""
    echo -e "  ${C_WHITE}[4/4] Setting up engram sync and git hooks...${C_RESET}"

    local project_name
    project_name=$(_sanitize_project_name "$(basename "$project_root")")

    if [[ "$OPT_DRY_RUN" == "true" ]]; then
        dry "Would run engram sync for project: $project_name"
        dry "Would install git hooks to: .git/hooks/"
        dry "Would create/update .gitattributes with engram diff rules"
    else
        # 4a. Run initial engram sync
        local engram_json engram_synced
        engram_json=$(initialize_engram_sync "$project_root" "$project_name")
        engram_synced=$(echo "$engram_json" | jq -r '.synced')

        if [[ "$engram_synced" == "true" ]]; then
            ok "engram sync completed -- .engram/ ready for team sharing"
        elif test_engram_installed; then
            ok "engram sync attempted -- no memories for this project yet"
        else
            ok ".engram/ will be created on first sync"
            warn "engram not installed -- sync will work after installing engram"
        fi

        # 4b. Install git hooks
        local hooks_json hooks_installed_list hooks_installed_count hooks_skipped_list
        hooks_json=$(install_git_hooks "$project_root" "$project_name")
        hooks_installed_list=$(echo "$hooks_json" | jq -r '.installed | join(", ")')
        hooks_installed_count=$(echo "$hooks_json" | jq '.installed | length')
        hooks_skipped_list=$(echo "$hooks_json" | jq -r '.skipped | join(", ")')

        if [[ "$hooks_installed_count" -gt 0 ]]; then
            ok "Git hooks installed: $hooks_installed_list"
        fi
        if echo "$hooks_json" | jq -e '.skipped | index("not-a-git-repo")' >/dev/null 2>&1; then
            warn "Not a git repo -- hooks skipped"
        elif [[ -n "$hooks_skipped_list" ]]; then
            step "Git hooks already present: $hooks_skipped_list"
        fi

        # 4c. Setup .gitattributes for clean PR diffs
        local ga_json ga_created ga_updated
        ga_json=$(ensure_gitattributes "$project_root")
        ga_created=$(echo "$ga_json" | jq -r '.created')
        ga_updated=$(echo "$ga_json" | jq -r '.updated')

        if [[ "$ga_created" == "true" ]]; then
            ok ".gitattributes created -- .engram/ diffs collapsed in PRs"
        elif [[ "$ga_updated" == "true" ]]; then
            ok ".gitattributes updated -- .engram/ diffs collapsed in PRs"
        else
            step ".gitattributes already configured"
        fi
    fi

    # -- Save project config ---------------------------------------------------
    if [[ "$OPT_DRY_RUN" == "true" ]]; then
        dry "Would save project config: .team-ai-kit.json"
    else
        local now
        now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
        local project_config
        project_config=$(jq -n \
            --arg role "$effective_role" \
            --arg ide "$effective_ide" \
            --arg team_repo "$effective_team_repo" \
            --arg initialized_at "$now" \
            --arg last_sync "$now" \
            --arg version "$KIT_VERSION" \
            '{role:$role, ide:$ide, teamRepo:$team_repo, initializedAt:$initialized_at, lastSync:$last_sync, version:$version}')
        save_project_config "$project_root" "$project_config" >/dev/null
        ok "Project config saved: .team-ai-kit.json"
    fi

    # -- Summary ---------------------------------------------------------------
    if [[ "$OPT_DRY_RUN" == "true" ]]; then
        echo ""
        echo -e "  ${C_CYAN}[DRY-RUN] No changes were made. The above shows what would happen.${C_RESET}"
        echo ""
    else
        echo ""
        echo -e "${C_GREEN}$(new_init_summary "$effective_ide" "$effective_role" "$rel_instructions_path" "$engram_synced" "$hooks_installed_count")${C_RESET}"

        echo ""
        echo -e "  ${C_YELLOW}Next steps:${C_RESET}"
        echo -e "    ${C_WHITE}1. Commit .team-ai-kit.json and $rel_instructions_path to your repo${C_RESET}"
        if [[ -n "$effective_team_repo" ]]; then
            local rel_skills_dir
            rel_skills_dir="$(get_ide_project_skills_directory "$effective_ide" "$project_root")"
            rel_skills_dir="${rel_skills_dir#$project_root/}"
            echo -e "    ${C_WHITE}2. Commit $rel_skills_dir/ (team skills for this project)${C_RESET}"
            echo -e "    ${C_WHITE}3. Commit .engram/ to share knowledge with your team${C_RESET}"
            echo -e "    ${C_WHITE}4. Start working -- git hooks will sync engram automatically!${C_RESET}"
        else
            echo -e "    ${C_WHITE}2. Commit .engram/ to share knowledge with your team${C_RESET}"
            echo -e "    ${C_WHITE}3. Start working -- git hooks will sync engram automatically!${C_RESET}"
        fi
        echo -e "    ${C_DIM}   (manual sync: team-ai-kit sync)${C_RESET}"
        echo ""
    fi
}

# -- Init Knowledge (scaffold team knowledge repo) ----------------------------
cmd_init_knowledge() {
    show_banner
    _require_jq || exit 1
    local target_dir
    target_dir=$(pwd)

    echo -e "  ${C_WHITE}Scaffolding Team Knowledge Repo...${C_RESET}"
    echo ""

    local result_json
    result_json=$(initialize_knowledge_repo "$target_dir")

    local created_count
    created_count=$(echo "$result_json" | jq '.created | length')

    if [[ "$created_count" -eq 0 ]]; then
        warn "All directories already exist. Nothing to create."
    else
        local dirs
        dirs=$(echo "$result_json" | jq -r '.created[]')
        while IFS= read -r dir; do
            [[ -z "$dir" ]] && continue
            ok "Created: $dir"
        done <<< "$dirs"
    fi

    echo ""
    ok "Team Knowledge Repo ready!"
    echo ""
    echo -e "  ${C_YELLOW}Structure:${C_RESET}"
    echo -e "    ${C_WHITE}skills/shared/<name>/SKILL.md    Skills for ALL roles${C_RESET}"
    echo -e "    ${C_WHITE}skills/roles/<role>/<name>/SKILL.md    Role-specific skills${C_RESET}"
    echo -e "    ${C_WHITE}rules/            Cross-project rules${C_RESET}"
    echo ""
    echo -e "  ${C_YELLOW}Next steps:${C_RESET}"
    echo -e "    ${C_WHITE}1. Add skills as folders: skills/shared/<name>/SKILL.md or skills/roles/<role>/<name>/SKILL.md${C_RESET}"
    echo -e "    ${C_WHITE}2. Add rules to rules/${C_RESET}"
    echo -e "    ${C_WHITE}3. git init && git add . && git commit && git push${C_RESET}"
    echo -e "    ${C_WHITE}4. Share the repo URL with your team:${C_RESET}"
    echo -e "    ${C_DIM}   team-ai-kit setup --team-repo <url>${C_RESET}"
    echo ""
    echo -e "  ${C_DIM}Docs: https://github.com/lazarogadiel93/team-ai-kit/blob/master/docs/team-knowledge-repo.md${C_RESET}"
    echo ""
}

# -- Sync (manual engram sync) -------------------------------------------------
cmd_sync() {
    show_banner
    _require_jq || exit 1
    local project_root
    project_root=$(pwd)
    # Check project config for project name
    local project_name=""
    if test_project_initialized "$project_root"; then
        project_name=$(_sanitize_project_name "$(basename "$project_root")")
    fi

    echo -e "  ${C_WHITE}Syncing engram memories...${C_RESET}"
    echo ""

    # Export
    step "Exporting local memories..."
    local export_json export_success export_msg
    export_json=$(invoke_engram_sync "$project_name" "export")
    export_success=$(echo "$export_json" | jq -r '.success')
    export_msg=$(echo "$export_json" | jq -r '.message')
    if [[ "$export_success" == "true" ]]; then
        ok "$export_msg"
    else
        warn "$export_msg"
    fi

    # Import
    step "Importing team memories..."
    local import_json import_success import_msg
    import_json=$(invoke_engram_sync "" "import")
    import_success=$(echo "$import_json" | jq -r '.success')
    import_msg=$(echo "$import_json" | jq -r '.message')
    if [[ "$import_success" == "true" ]]; then
        ok "$import_msg"
    else
        warn "$import_msg"
    fi

    echo ""
    if [[ "$export_success" == "true" || "$import_success" == "true" ]]; then
        ok "Sync complete"
    else
        err 'Sync failed -- is engram installed? Run "team-ai-kit doctor" to check.'
    fi
    echo ""
}

# -- Update --------------------------------------------------------------------
cmd_update() {
    show_banner
    _require_jq || exit 1
    local config_ide config_role
    config_ide=$(get_config_value "ide")
    config_role=$(get_config_value "role")

    if [[ -z "$config_ide" ]]; then
        err 'No configuration found. Run "team-ai-kit setup" first.'
        exit 1
    fi

    echo -e "  ${C_WHITE}Updating for: IDE=$config_ide, Role=$config_role${C_RESET}"
    echo ""

    # Resolve team repo: project config > global config
    local project_root effective_team_repo="" has_project_config="false"
    project_root=$(pwd)
    if test_project_initialized "$project_root"; then
        has_project_config="true"
        effective_team_repo=$(get_project_config_value "$project_root" "teamRepo" 2>/dev/null) || true
    fi
    if [[ -z "$effective_team_repo" ]]; then
        effective_team_repo=$(get_config_value "teamRepo" 2>/dev/null) || true
    fi

    # Step 1: Pull team repo if configured
    local has_team_repo="false"

    if [[ -n "$effective_team_repo" ]]; then
        step "Pulling team repo: $effective_team_repo"
        if test_team_repo_cloned "$effective_team_repo"; then
            if invoke_team_repo_pull "$effective_team_repo"; then
                ok "Team repo updated"
                has_team_repo="true"
            else
                warn "Failed to pull team repo -- continuing with cached version"
                has_team_repo="true"
            fi
        else
            step "Team repo not cloned yet -- cloning..."
            if invoke_team_repo_clone "$effective_team_repo"; then
                ok "Team repo cloned"
                has_team_repo="true"
            else
                warn "Failed to clone team repo -- continuing with defaults only"
            fi
        fi
        # Safety net: if a cached clone exists from a previous run, use it
        if [[ "$has_team_repo" == "false" ]] && test_team_repo_cloned "$effective_team_repo"; then
            has_team_repo="true"
        fi
    else
        step 'No team repo configured (use "team-ai-kit setup --team-repo <url>" to add one)'
    fi

    # Step 2: Merge kit base skills to global (no team-repo layer)
    local target_skills_dir
    if [[ -n "$OPT_TARGET_DIR" ]]; then
        target_skills_dir="$OPT_TARGET_DIR"
    else
        target_skills_dir=$(get_ide_skills_directory "$config_ide")
    fi

    if [[ "$OPT_DRY_RUN" == "true" ]]; then
        dry "Would merge kit base skills to: $target_skills_dir"
    else
        step "Merging kit base skills to global: $target_skills_dir"

        local merge_json
        merge_json=$(install_skills_with_merge "$KIT_ROOT" "$config_role" "$target_skills_dir" "false" "")
        local m_installed m_updated m_skipped
        m_installed=$(echo "$merge_json" | jq -r '.installed')
        m_updated=$(echo "$merge_json" | jq -r '.updated')
        m_skipped=$(echo "$merge_json" | jq -r '.skipped')

        echo ""
        ok "Installed: $m_installed new skills"
        [[ "$m_updated" -gt 0 ]] && ok "Updated:   $m_updated skills (source changed, yours untouched)"
        [[ "$m_skipped" -gt 0 ]] && step "Unchanged: $m_skipped skills (already up to date or user-modified)"
    fi

    # Step 2b: Install team-repo skills to project-level directory
    if [[ "$has_team_repo" == "true" && "$has_project_config" == "true" ]]; then
        local effective_ide effective_role_proj project_skills_dir
        effective_ide=$(get_project_config_value "$project_root" "ide" 2>/dev/null) || true
        [[ -z "$effective_ide" ]] && effective_ide="$config_ide"
        effective_role_proj=$(get_project_config_value "$project_root" "role" 2>/dev/null) || true
        [[ -z "$effective_role_proj" ]] && effective_role_proj="$config_role"
        project_skills_dir=$(get_ide_project_skills_directory "$effective_ide" "$project_root")
        local rel_dir="${project_skills_dir#$project_root/}"

        if [[ "$OPT_DRY_RUN" == "true" ]]; then
            dry "Would merge team skills to: $rel_dir"
        else
            echo ""
            step "Merging team skills to project: $rel_dir"

            local ps_json ps_installed ps_updated ps_skipped
            ps_json=$(install_project_skills "$effective_role_proj" "$effective_team_repo" "$project_skills_dir")
            ps_installed=$(echo "$ps_json" | jq -r '.installed')
            ps_updated=$(echo "$ps_json" | jq -r '.updated')
            ps_skipped=$(echo "$ps_json" | jq -r '.skipped')
            [[ "$ps_installed" -gt 0 ]] && ok "Installed: $ps_installed new team skills"
            [[ "$ps_updated" -gt 0 ]] && ok "Updated:   $ps_updated team skills"
            [[ "$ps_skipped" -gt 0 ]] && step "Unchanged: $ps_skipped team skills"
        fi
    fi

    # Step 3: Auto-update team rules in instructions if project is initialized
    if [[ "$has_team_repo" == "true" && "$has_project_config" == "true" ]]; then
        local team_rules_content
        team_rules_content=$(get_team_repo_rules_content "$effective_team_repo")
        if [[ -n "$team_rules_content" ]]; then
            local instructions_path
            instructions_path=$(get_ide_instructions_path "$config_ide" "$project_root")
            if [[ -f "$instructions_path" ]]; then
                if [[ "$OPT_DRY_RUN" == "true" ]]; then
                    dry "Would update team rules in: ${instructions_path#$project_root/}"
                else
                    local rules_result
                    rules_result=$(update_instructions_team_rules "$instructions_path" "$team_rules_content")
                    if [[ "$rules_result" == "changed" ]]; then
                        ok "Team rules updated in project instructions"
                    else
                        step "Team rules unchanged in project instructions"
                    fi
                fi
            fi
        fi
    fi

    # Step 4: Auto-update Engram Memory Protocol in instructions
    # Skip for IDEs where gentle-ai handles the protocol globally
    if [[ "$has_project_config" == "true" ]]; then
        local instructions_path
        instructions_path=$(get_ide_instructions_path "$config_ide" "$project_root")
        if [[ -f "$instructions_path" ]]; then
            if [[ "$OPT_DRY_RUN" == "true" ]]; then
                dry "Would update engram protocol in: ${instructions_path#$project_root/}"
            else
                local skip_engram_protocol="false"
                if test_gentle_ai_supports_ide "$config_ide"; then
                    skip_engram_protocol="true"
                fi
                local protocol_result
                protocol_result=$(update_instructions_engram_protocol "$instructions_path" "$skip_engram_protocol")
                if [[ "$protocol_result" == "changed" ]]; then
                    if [[ "$skip_engram_protocol" == "true" ]]; then
                        ok "Engram Memory Protocol removed from project instructions (gentle-ai handles it)"
                    else
                        ok "Engram Memory Protocol updated in project instructions"
                    fi
                else
                    step "Engram Memory Protocol unchanged in project instructions"
                fi
            fi
        fi
    fi

    # Step 4b: Ensure .gitattributes has engram diff rules
    if [[ "$OPT_DRY_RUN" == "true" ]]; then
        dry "Would ensure .gitattributes has engram diff rules"
    else
        local ga_json ga_created ga_updated
        ga_json=$(ensure_gitattributes "$project_root")
        ga_created=$(echo "$ga_json" | jq -r '.created')
        ga_updated=$(echo "$ga_json" | jq -r '.updated')

        if [[ "$ga_created" == "true" ]]; then
            ok ".gitattributes created -- .engram/ diffs collapsed in PRs"
        elif [[ "$ga_updated" == "true" ]]; then
            ok ".gitattributes updated -- .engram/ diffs collapsed in PRs"
        else
            step ".gitattributes already configured"
        fi
    fi

    # Step 5: Update config timestamp
    if [[ "$OPT_DRY_RUN" == "true" ]]; then
        echo ""
        dry "Would update global config timestamp"
        echo ""
        echo -e "  ${C_CYAN}[DRY-RUN] No changes were made. The above shows what would happen.${C_RESET}"
        echo ""
    else
        local now
        now=$(date -u +"%Y-%m-%dT%H:%M:%SZ")
        local updated_config
        updated_config=$(get_config | jq --arg ts "$now" --arg ver "$KIT_VERSION" '.lastUpdate = $ts | .version = $ver')
        save_config "$updated_config" >/dev/null
        echo ""
        ok "Update complete"
        echo ""
    fi
}

# -- Status --------------------------------------------------------------------
cmd_status() {
    show_banner
    _require_jq || exit 1
    local config_ide config_role config_provider config_team config_installed config_update config_version
    config_ide=$(get_config_value "ide")
    config_role=$(get_config_value "role")
    config_provider=$(get_config_value "provider")
    config_team=$(get_config_value "teamRepo")
    config_installed=$(get_config_value "installedAt")
    config_update=$(get_config_value "lastUpdate")
    config_version=$(get_config_value "version")

    if [[ -z "$config_ide" ]]; then
        warn 'Not configured yet. Run "team-ai-kit setup" first.'
        echo ""
        return
    fi

    # Resolve per-project > global team repo
    local effective_team_repo="$config_team"
    local project_root
    project_root=$(pwd)
    if test_project_initialized "$project_root"; then
        local pt
        pt=$(get_project_config_value "$project_root" "teamRepo" 2>/dev/null) || true
        if [[ -n "$pt" ]]; then effective_team_repo="$pt"; fi
    fi

    echo -e "  ${C_WHITE}Configuration:${C_RESET}"
    echo "    IDE:         $config_ide"
    echo "    Role:        $config_role"
    echo "    Provider:    $config_provider"
    echo "    Team Repo:   ${effective_team_repo:-(none)}"
    echo "    Installed:   $config_installed"
    echo "    Last Update: $config_update"
    echo "    Version:     ${config_version:-unknown}"
    echo ""

    # Show installed skills from manifest
    local manifest_json file_count
    manifest_json=$(get_skill_manifest)
    file_count=$(echo "$manifest_json" | jq '.files | length')

    if [[ "$file_count" -gt 0 ]]; then
        local default_count team_count
        default_count=$(echo "$manifest_json" | jq '[.files[] | select(.source == "default")] | length')
        team_count=$(echo "$manifest_json" | jq '[.files[] | select(.source == "team")] | length')
        echo -e "  ${C_WHITE}Global Skills: $file_count tracked ($default_count default, $team_count team)${C_RESET}"

        # Check for user modifications
        local skills_dir modified_count=0
        skills_dir=$(get_ide_skills_directory "$config_ide")
        local keys
        keys=$(echo "$manifest_json" | jq -r '.files | keys[]')
        while IFS= read -r key; do
            [[ -z "$key" ]] && continue
            local file_path="$skills_dir/$key"
            if test_skill_modified_by_user "$file_path" "$key" "$manifest_json" 2>/dev/null; then
                ((modified_count++))
            fi
        done <<< "$keys"

        if [[ "$modified_count" -gt 0 ]]; then
            warn "$modified_count skill(s) modified locally (protected from overwrite)"
        fi
    else
        local skills_dir team_skills_dir
        skills_dir=$(get_ide_skills_directory "$config_ide")
        team_skills_dir="$skills_dir/team-skills"
        if [[ -d "$team_skills_dir" ]]; then
            local skill_count
            skill_count=$(find "$team_skills_dir" -name 'SKILL.md' -type f | wc -l | tr -d ' ')
            echo -e "  ${C_WHITE}Installed Skills: $skill_count (no manifest -- run update to track)${C_RESET}"
        else
            warn "Global skills directory not found: $team_skills_dir"
        fi
    fi

    # Show project-level skills
    if test_project_initialized "$project_root"; then
        local project_ide project_skills_dir project_team_dir
        project_ide=$(get_project_config_value "$project_root" "ide" 2>/dev/null) || true
        [[ -z "$project_ide" ]] && project_ide="$config_ide"
        project_skills_dir=$(get_ide_project_skills_directory "$project_ide" "$project_root")
        project_team_dir="$project_skills_dir/team-skills"
        if [[ -d "$project_team_dir" ]]; then
            local p_count
            p_count=$(find "$project_team_dir" -name 'SKILL.md' -type f | wc -l | tr -d ' ')
            local rel_dir="${project_skills_dir#$project_root/}"
            echo -e "  ${C_WHITE}Project Skills: $p_count in $rel_dir/${C_RESET}"
        else
            step 'Project skills: none (run "team-ai-kit init" with a team repo)'
        fi
    fi

    # Team repo status
    if [[ -n "$effective_team_repo" ]]; then
        echo ""
        if test_team_repo_cloned "$effective_team_repo"; then
            ok "Team repo: cloned locally"
        else
            warn 'Team repo: configured but not cloned (run "team-ai-kit update")'
        fi
    fi
    echo ""
}

# -- Doctor --------------------------------------------------------------------
cmd_doctor() {
    show_banner
    _require_jq || exit 1
    echo -e "  ${C_WHITE}Checking installation health...${C_RESET}"
    echo ""

    local all_good=true

    # jq (required)
    if test_jq_installed; then ok "jq: installed"
    else err "jq: NOT found (required)"; all_good=false; fi

    # Homebrew (optional)
    if test_brew_installed; then ok "Homebrew: installed"
    else warn "Homebrew: NOT found (optional -- direct download available)"; fi

    # gentle-ai
    if test_gentle_ai_installed; then
        local gentle_path=""
        gentle_path=$(get_gentle_ai_binary_path 2>/dev/null) || gentle_path="(in PATH)"
        ok "gentle-ai: installed ($gentle_path)"
    else err "gentle-ai: NOT found"; all_good=false; fi

    # engram
    if test_engram_installed; then
        local engram_path=""
        engram_path=$(get_engram_binary_path 2>/dev/null) || engram_path="(in PATH)"
        ok "engram: installed ($engram_path)"
    else err "engram: NOT found"; all_good=false; fi

    # Config
    local config_ide
    config_ide=$(get_config_value "ide")
    if [[ -n "$config_ide" ]]; then
        local config_role
        config_role=$(get_config_value "role")
        ok "Config: found (IDE=$config_ide, Role=$config_role)"
    else
        warn 'Config: not configured (run "team-ai-kit setup")'
    fi

    # Global skills directory
    if [[ -n "$config_ide" ]]; then
        local skills_dir team_skills_dir
        skills_dir=$(get_ide_skills_directory "$config_ide")
        team_skills_dir="$skills_dir/team-skills"
        if [[ -d "$team_skills_dir" ]]; then
            local count
            count=$(find "$team_skills_dir" -name 'SKILL.md' -type f | wc -l | tr -d ' ')
            ok "Global skills: $count files in $team_skills_dir"
        else
            warn "Global skills: directory not found ($team_skills_dir)"
        fi
    fi

    # Project-level skills
    local project_root
    project_root=$(pwd)
    if [[ -n "$config_ide" ]] && test_project_initialized "$project_root"; then
        local project_ide project_skills_dir project_team_dir
        project_ide=$(get_project_config_value "$project_root" "ide" 2>/dev/null) || true
        [[ -z "$project_ide" ]] && project_ide="$config_ide"
        project_skills_dir=$(get_ide_project_skills_directory "$project_ide" "$project_root")
        project_team_dir="$project_skills_dir/team-skills"
        if [[ -d "$project_team_dir" ]]; then
            local p_count
            p_count=$(find "$project_team_dir" -name 'SKILL.md' -type f | wc -l | tr -d ' ')
            local rel_dir="${project_skills_dir#$project_root/}"
            ok "Project skills: $p_count files in $rel_dir/"
        else
            step 'Project skills: not installed (run "team-ai-kit init" with a team repo)'
        fi
    fi

    # Team repo
    local config_team
    config_team=$(get_config_value "teamRepo")
    if [[ -n "$config_team" ]]; then
        ok "Team repo: $config_team"
    else
        warn "Team repo: not configured"
    fi

    echo ""
    if $all_good; then
        ok "All checks passed!"
    else
        err "Some checks failed. Fix the issues above and run doctor again."
    fi
    echo ""
}

# -- Uninstall -----------------------------------------------------------------
cmd_uninstall() {
    show_banner
    _require_jq || exit 1
    local project_root
    project_root=$(pwd)
    if ! test_project_initialized "$project_root"; then
        err "No team-ai-kit project found in this directory."
        echo "  Run this command from a project that was initialized with 'team-ai-kit init'."
        exit 1
    fi

    echo -e "  ${C_WHITE}Scanning for team-ai-kit artifacts...${C_RESET}"
    echo ""

    local targets
    targets=$(collect_uninstall_targets "$project_root")

    if [[ -z "$targets" ]]; then
        echo -e "  ${C_DIM}No artifacts found to remove.${C_RESET}"
        echo ""
        return
    fi

    # Show what will be removed
    echo -e "  ${C_YELLOW}The following will be removed:${C_RESET}"
    while IFS= read -r target; do
        [[ -z "$target" ]] && continue
        if [[ "$target" == hook:* ]]; then
            local hook_path="${target#hook:}"
            local rel_hook="${hook_path#$project_root/}"
            echo -e "    ${C_RED}~ $rel_hook${C_RESET} (team-ai-kit block)"
        elif [[ "$target" == gitattributes:* ]]; then
            echo -e "    ${C_RED}~ .gitattributes${C_RESET} (team-ai-kit lines)"
        elif [[ -d "$target" ]]; then
            local rel="${target#$project_root/}"
            echo -e "    ${C_RED}- $rel/${C_RESET}"
        else
            local rel="${target#$project_root/}"
            echo -e "    ${C_RED}- $rel${C_RESET}"
        fi
    done <<< "$targets"

    # Also mention manifest
    local manifest_path
    manifest_path=$(get_skill_manifest_path)
    if [[ -f "$manifest_path" ]]; then
        echo -e "    ${C_RED}- $(basename "$manifest_path")${C_RESET} (global manifest)"
    fi

    echo ""

    if [[ "$OPT_DRY_RUN" == "true" ]]; then
        echo -e "  ${C_CYAN}[DRY-RUN] No changes were made. The above shows what would be removed.${C_RESET}"
        echo ""
        return
    fi

    # Ask for confirmation unless --force
    if [[ "$OPT_FORCE" != "true" ]]; then
        echo -ne "  ${C_YELLOW}Are you sure? This cannot be undone. [y/N]: ${C_RESET}"
        read -r confirm
        if [[ "$confirm" != "y" && "$confirm" != "Y" ]]; then
            echo -e "  ${C_DIM}Uninstall cancelled.${C_RESET}"
            echo ""
            return
        fi
    fi

    echo ""
    local result
    result=$(uninstall_project "$project_root")
    local removed
    removed=$(echo "$result" | jq -r '.removed')

    echo -e "  ${C_GREEN}✔ Uninstalled team-ai-kit from this project ($removed items removed).${C_RESET}"
    echo ""
    echo -e "  ${C_DIM}Tip: You may also want to remove .engram/ if you no longer need memory sync.${C_RESET}"
    echo ""
}

# -- Parse args ----------------------------------------------------------------
COMMAND="${1:-help}"
shift || true

OPT_IDE=""
OPT_ROLE=""
OPT_PROVIDER=""
OPT_TEAM_REPO=""
OPT_TARGET_DIR=""
SKIP_PREREQUISITES="false"
SKIP_GENTLE_AI="false"
OPT_FORCE="false"
OPT_DRY_RUN="false"

while [[ $# -gt 0 ]]; do
    case "$1" in
        --ide)
            [[ $# -ge 2 ]] || { err "Missing value for --ide"; exit 1; }
            OPT_IDE="$2"; shift 2 ;;
        --role)
            [[ $# -ge 2 ]] || { err "Missing value for --role"; exit 1; }
            OPT_ROLE="$2"; shift 2 ;;
        --provider)
            [[ $# -ge 2 ]] || { err "Missing value for --provider"; exit 1; }
            OPT_PROVIDER="$2"; shift 2 ;;
        --team-repo)
            [[ $# -ge 2 ]] || { err "Missing value for --team-repo"; exit 1; }
            OPT_TEAM_REPO="$2"; shift 2 ;;
        --target-dir)
            [[ $# -ge 2 ]] || { err "Missing value for --target-dir"; exit 1; }
            OPT_TARGET_DIR="$2"; shift 2 ;;
        --skip-prerequisites) SKIP_PREREQUISITES="true"; shift ;;
        --skip-gentle-ai)    SKIP_GENTLE_AI="true"; shift ;;
        --force)             OPT_FORCE="true"; shift ;;
        --dry-run)           OPT_DRY_RUN="true"; shift ;;
        *)
            err "Unknown option: $1"
            echo '  Run "team-ai-kit help" for usage.'
            exit 1
            ;;
    esac
done

# -- Validate provided arguments -----------------------------------------------
if [[ -n "$OPT_IDE" ]] && ! test_valid_ide "$OPT_IDE"; then
    err "Invalid IDE: '$OPT_IDE'. Valid values: ${VALID_IDES[*]}"
    exit 1
fi
if [[ -n "$OPT_ROLE" ]] && ! test_valid_role "$OPT_ROLE"; then
    err "Invalid role: '$OPT_ROLE'. Valid values: ${VALID_ROLES[*]}"
    exit 1
fi
if [[ -n "$OPT_PROVIDER" ]] && ! test_valid_provider "$OPT_PROVIDER"; then
    err "Invalid provider: '$OPT_PROVIDER'. Valid values: ${VALID_PROVIDERS[*]}"
    exit 1
fi

# -- Route subcommand ----------------------------------------------------------
case "$(_lowercase "$COMMAND")" in
    setup)           cmd_setup ;;
    init)            cmd_init ;;
    init-knowledge)  cmd_init_knowledge ;;
    sync)            cmd_sync ;;
    update) cmd_update ;;
    status) cmd_status ;;
    doctor) cmd_doctor ;;
    uninstall)       cmd_uninstall ;;
    help)   show_help ;;
    *)
        err "Unknown command: $COMMAND"
        echo '  Run "team-ai-kit help" for available commands.'
        exit 1
        ;;
esac
